# Copy this file to .env for local development.
# Keep the Gemini key in .env or the deployment host's secret manager only.

PACE_BASE_URL=https://pace.ac.in/
PACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PACE_LLM_PROVIDER=gemini
PACE_GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
PACE_GEMINI_MAX_OUTPUT_TOKENS=1024
PACE_GEMINI_TIMEOUT=45
PACE_USE_CROSS_ENCODER=false
PACE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PACE_MIN_RETRIEVAL_SCORE=0.35
PACE_MIN_VECTOR_EVIDENCE=0.58
PACE_MIN_LEXICAL_EVIDENCE=0.25
PACE_MAX_CONTEXT_WORDS=900
PACE_CHUNK_TOKEN_LIMIT=448
PACE_CHUNK_TOKEN_OVERLAP=48
PACE_MAX_CONTEXT_SOURCES=3
PACE_RETRIEVAL_CACHE_SIZE=128
PACE_RETRIEVAL_CACHE_TTL=300
PACE_VECTOR_WEIGHT=0.50
PACE_BM25_WEIGHT=0.50
PACE_MAX_CHUNKS_PER_SOURCE=2
PACE_DEBUG=false
